//
//  Prod.secrets.xcconfig.example
//  pitgo
//
//  Copie este arquivo para "Prod.secrets.xcconfig" (mesma pasta) e preencha com os valores reais do
//  projeto Supabase de Homol/Prod. "Prod.secrets.xcconfig" NUNCA deve ser commitado — já está em
//  .gitignore. `Homol.xcconfig` inclui este mesmo arquivo (ver nota lá) — não crie um
//  Homol.secrets.xcconfig separado.
//
//  supabaseKey aceita:
//   - uma chave publishable atual (prefixo "sb_publishable_"); ou
//   - a chave pública/anon legada (JWT de 3 segmentos com claim "role": "anon").
//  Chaves "sb_secret_"/service_role NUNCA devem ser usadas aqui — o Run Script Build Phase rejeita
//  o build se detectar uma (ver Scripts/validate-supabase-config.sh).
//
supabaseProjectRef = SEU-PROJETO-REF
supabaseUrl = https:/$()/SEU-PROJETO-REF.supabase.co
supabaseKey = sb_publishable_SUA_CHAVE_AQUI

// Obrigatória em Homol/Prod — chave pública real, nunca o Access Token.
mercadoPagoPublicKey = APP_USR-SUA_CHAVE_AQUI

// mapStyleUrl (009, opcional): sobrescreva com o Style JSON do seu provedor de tiles OSM
// gerenciado. Sem esta linha, o app usa o default público de avaliação definido em Shared.xcconfig
// (não é infraestrutura de produção).
// mapStyleUrl = https:/$()/SEU-PROVEDOR-DE-TILES/style.json
