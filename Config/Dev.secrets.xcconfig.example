//
//  Dev.secrets.xcconfig.example
//  pitgo
//
//  Copie este arquivo para "Dev.secrets.xcconfig" (mesma pasta) e preencha com os valores de um
//  projeto Supabase de desenvolvimento SEPARADO de Homol/Prod (`027` FR-002). "Dev.secrets.xcconfig"
//  NUNCA deve ser commitado — já está em .gitignore.
//
//  Não defina mercadoPagoPublicKey aqui — Dev.xcconfig força o valor vazio por último mesmo que
//  definida, porque Dev nunca inicia uma transação real (SimulatedPaymentGateway cobre o fluxo).
//
supabaseProjectRef = SEU-PROJETO-DEV-REF
supabaseUrl = https:/$()/SEU-PROJETO-DEV-REF.supabase.co
supabaseKey = sb_publishable_SUA_CHAVE_DEV_AQUI

// mapStyleUrl (opcional): sobrescreva com o Style JSON do seu provedor de tiles OSM gerenciado.
// Sem esta linha, o app usa o default público de avaliação definido em Shared.xcconfig.
// mapStyleUrl = https:/$()/SEU-PROVEDOR-DE-TILES/style.json
